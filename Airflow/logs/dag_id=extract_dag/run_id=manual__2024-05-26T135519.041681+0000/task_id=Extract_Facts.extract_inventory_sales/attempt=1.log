INSERT INTO staging_area.Inventory_Transactions (date, db_id, customer_id, product_id, warehouse_id, quantity, cost, fullfilment, delay, freight_charges, transaction_type)
With OrderTotals As 
(
	SELECT st.transaction_id, SUM(td.units_sold * td.unit_selling_price) AS total_cost
	FROM Sales_Transaction st JOIN Transaction_Details td using (transaction_id)
	GROUP BY st.transaction_id
)
SELECT 
    st.transaction_date AS date,
    st.transaction_id AS db_id,
    st.customer_id,
    td.product_id,
    st.warehouse_id,
    td.units_sold AS quantity,
    td.unit_selling_price AS cost,
    IF(sh.shipment_status = 'Shipped', 1, 0) AS fullfilment,
    IF(sh.shipment_status = 'Shipped', DATEDIFF(sh.delivered_date, st.expected_delivery), null) AS delay,
    (sh.freight_charges * (td.units_sold * td.unit_selling_price) / ot.total_cost) AS freight_charges,
    'Sales' AS transaction_type
FROM Sales_Transaction st JOIN Transaction_Details td USING (transaction_id) LEFT JOIN Shipment sh using(transaction_id) JOIN OrderTotals ot using  (transaction_id);
ON DUPLICATE KEY UPDATE
    fullfilment = VALUES(fullfilment),
    delay = VALUES(delay);
