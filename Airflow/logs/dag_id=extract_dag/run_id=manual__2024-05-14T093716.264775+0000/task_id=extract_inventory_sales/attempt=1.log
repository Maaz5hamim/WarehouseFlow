[2024-05-14T09:38:15.301+0000] {sql.py:276} INFO - Executing: INSERT INTO staging_area.Inventory_Transactions (date, db_id, customer_id, product_id, warehouse_id, quantity, cost, fullfilment, delay, transaction_type)
SELECT 
    st.transaction_date AS date,
    st.transaction_id AS db_id,
    st.customer_id,
    td.product_id,
    st.warehouse_id,
    td.units_sold AS quantity,
    td.unit_selling_price AS cost,
    IF(sh.shipment_status = 'Shipped', 1, 0) AS fullfilment,
    IF(sh.shipment_status = 'Shipped', DATEDIFF(sh.delivered_date, st.expected_delivery), null) AS delay,
    'Sales' AS transaction_type
FROM 
    Sales_Transaction st
    JOIN Transaction_Details td USING (transaction_id)
    LEFT JOIN Shipment sh using(transaction_id)
ON DUPLICATE KEY UPDATE
    fullfilment = VALUES(fullfilment),
    delay = VALUES(delay);
