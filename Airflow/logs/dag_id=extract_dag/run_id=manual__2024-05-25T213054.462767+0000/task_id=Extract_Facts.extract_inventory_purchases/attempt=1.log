INSERT IGNORE INTO staging_area.Inventory_Transactions (date, db_id, supplier_id, product_id, warehouse_id, quantity, cost, fullfilment, delay, freight_charges, transaction_type)
SELECT 
    po.order_date AS date,
    po.order_id AS db_id,
    po.supplier_id,
    pod.product_id,
    po.shipment_destination AS warehouse_id,
    pod.units_bought AS quantity,
    pod.unit_cost_price AS cost,
    IF(po.order_status = 'Shipped', 1, 0) AS fullfilment,
    IF(po.order_status = 'Shipped', DATEDIFF(po.actual_shipment, po.expected_shipment), NULL) AS delay,
    po.freight_charges,
    'Purchases' AS transaction_type
FROM Purchase_Order po JOIN Purchase_Order_Details pod USING (order_id)
ON DUPLICATE KEY UPDATE
    fullfilment = VALUES(fullfilment),
    delay = VALUES(delay);
